{
  "manifest_version": 3,
  "name": "Custom Web Blocker",
  "version": "1.1.0",
  "description": "Block websites you choose with native blocking, delayed usage limits, or event-driven custom rules.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "declarativeNetRequest", "alarms", "offscreen", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["helpers.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Custom Web Blocker",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "sandbox": {
    "pages": ["event-sandbox.html"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "event-sandbox.html",
        "offscreen.html",
        "message-page.html",
        "message-page.js",
        "message-page.css",
        "icon-16.png",
        "icon-32.png",
        "icon-48.png",
        "icon-128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
