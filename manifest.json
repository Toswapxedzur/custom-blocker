{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.0.1",
  "description": "__MSG_appDescription__",
  "key": "",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "offscreen", "tabs", "webNavigation", "favicon", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/adamancia-vault-lock-v3-16.png",
    "32": "icons/adamancia-vault-lock-v3-32.png",
    "48": "icons/adamancia-vault-lock-v3-48.png",
    "128": "icons/adamancia-vault-lock-v3-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["platform-profiles.js", "helpers.js", "content.js", "vault-classifier-contract.js", "vault-classifier-tag-ui.js", "vault-classifier-collector-core.js", "vault-classifier-tiktok.js", "vault-classifier-facebook.js", "vault-classifier-instagram.js", "vault-classifier-twitch.js", "vault-classifier-reddit.js", "vault-classifier-discord.js", "vault-classifier-twitter.js", "vault-classifier-bilibili.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://youtube.com/*", "*://*.youtube.com/*"],
      "js": ["vault-classifier-contract.js", "vault-classifier-tag-ui.js", "vault-classifier-youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/adamancia-vault-lock-v3-16.png",
      "32": "icons/adamancia-vault-lock-v3-32.png",
      "48": "icons/adamancia-vault-lock-v3-48.png"
    }
  },
  "sandbox": {
    "pages": ["event-sandbox.html"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "event-sandbox.html",
        "offscreen.html",
        "message-page.html",
        "message-page.js",
        "message-page.css",
        "icons/adamancia-vault-lock-v3-16.png",
        "icons/adamancia-vault-lock-v3-32.png",
        "icons/adamancia-vault-lock-v3-48.png",
        "icons/adamancia-vault-lock-v3-128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
