{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.4.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/adamancia-vault-lock-v3-16.png",
    "32": "icons/adamancia-vault-lock-v3-32.png",
    "48": "icons/adamancia-vault-lock-v3-48.png",
    "128": "icons/adamancia-vault-lock-v3-128.png"
  },
  "background": {
    "scripts": [
      "browser-compat.js",
      "safari-runtime-config.js",
      "sandbox-transport.js",
      "bridge-protocol.js",
      "local-hub-environment.js",
      "platform-profiles.js",
      "group-scopes.js",
      "parental-pin.js",
      "group-actions.js",
      "vault-classifier-contract.js",
      "local-hub-auth.js",
      "vault-classifier-bridge.js",
      "vault-activity.js",
      "safari-native-lifecycle.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "browser-compat.js",
        "platform-profiles.js",
        "content.js",
        "vault-classifier-contract.js",
        "vault-classifier-tag-ui.js",
        "vault-classifier-collector-core.js",
        "vault-classifier-facebook.js",
        "vault-classifier-instagram.js",
        "vault-classifier-twitch.js",
        "vault-classifier-reddit.js",
        "vault-classifier-discord.js",
        "vault-classifier-twitter.js",
        "vault-classifier-bilibili.js",
        "vault-activity-content.js",
        "safari-lifecycle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "vault-classifier-youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "cover-frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/adamancia-vault-lock-v3-16.png",
      "32": "icons/adamancia-vault-lock-v3-32.png",
      "48": "icons/adamancia-vault-lock-v3-48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "message-page.html",
        "message-page.js",
        "message-page.css",
        "icons/adamancia-vault-lock-v3-16.png",
        "icons/adamancia-vault-lock-v3-32.png",
        "icons/adamancia-vault-lock-v3-48.png",
        "icons/adamancia-vault-lock-v3-128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
